{
  "name": "fernjo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "tauri": "tauri",
    "lint": "eslint . && prettier --check ui \"*.{js,json}\" && svelte-check --tsconfig ui/tsconfig.json --fail-on-warnings",
    "check": "svelte-check --tsconfig ui/tsconfig.json --fail-on-warnings",
    "test": "vitest run --config ui/vite.config.ts",
    "format": "prettier --write ui \"*.{js,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/red-hat-mono": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "@tsconfig/svelte": "^5.0.9",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  }
}
