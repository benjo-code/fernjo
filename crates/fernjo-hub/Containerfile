# Build from the repository root:
#   podman build -f crates/fernjo-hub/Containerfile -t fernjo-hub .
# Static musl binary, non-root user, nothing else in the image.

FROM docker.io/library/rust:1.90-alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p fernjo-hub --target "$(uname -m)-unknown-linux-musl" \
 && cp "target/$(uname -m)-unknown-linux-musl/release/fernjo-hub" /fernjo-hub

FROM scratch
COPY --from=build /fernjo-hub /fernjo-hub
# the data volume is the only writable place; owned by the unprivileged user
USER 10001:10001
VOLUME /data
EXPOSE 8787
ENTRYPOINT ["/fernjo-hub"]
CMD ["serve", "--data", "/data", "--listen", "0.0.0.0:8787"]
