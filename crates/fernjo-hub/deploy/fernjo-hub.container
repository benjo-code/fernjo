# Rootless Quadlet unit: ~/.config/containers/systemd/fernjo-hub.container
# Before the first start run `init` once on the volume (Docs/hub.md, "Set it up from the published image").
# The image is pulled on the first start; the tag is bumped together with every release.

[Unit]
Description=fernjo sync hub
After=network-online.target

[Container]
Image=ghcr.io/benjo-code/fernjo-hub:0.4.0
ContainerName=fernjo-hub
# only loopback on the host: Caddy is the one that is reachable
PublishPort=127.0.0.1:8787:8787
Volume=fernjo-hub-data:/data:Z
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
# the image runs as 10001; in a rootless user namespace map it onto the volume's owner
UserNS=keep-id:uid=10001,gid=10001
User=10001:10001
# a tiny init as PID 1 (belt and braces next to the hub's own SIGTERM handling)
RunInit=true

[Service]
Restart=always

[Install]
WantedBy=default.target
