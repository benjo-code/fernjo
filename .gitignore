# the synced known_hosts, and a sync hub's data folder (head.env, history/<seq>.env).
*.fjbk
fernjo-connections-*.json
*.bak
.device/
sync.json
sync-base.json
open-tabs.json
vault-marks.json
known_hosts
known_hosts.confirmed
rdp_certs.confirmed
appmenu-never
*.env

