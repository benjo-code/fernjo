{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fernjo",
  "identifier": "io.github.benjo-code.fernjo",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "pnpm ui:dev",
    "beforeBuildCommand": "pnpm ui:build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "fernjo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-component-update"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "SSH connection manager with a connection tree and tabbed sessions.",
    "longDescription": "fernjo manages SSH connections in a tree with inherited settings, opens sessions as tabs in one window and keeps credentials in an encrypted vault.",
    "copyright": "Copyright (c) 2026 fernjo contributors",
    "resources": ["resources/THIRD-PARTY-NOTICES.md"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
